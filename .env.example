# Cấu hình máy chủ Backend Node.js
PORT=5000

# Chuỗi kết nối PostgreSQL (Thay đổi tài khoản, mật khẩu, database của bạn)
# Định dạng: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/haven_3d

# Khóa bí mật cho JWT (nếu mở rộng bảo mật token)
JWT_SECRET=haven_home_super_secret_jwt_key_2026

